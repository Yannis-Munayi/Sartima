# Sartima QA settings. Copy to qa/.env (gitignored) and fill in what you have.
# Everything is optional: tests that need a missing setting show as "Needs setup".

# The live site the Live tab checks
QA_LIVE_URL=https://sartima.ca

# Dedicated test accounts (NOT your real account — tests overwrite their closet,
# liked items, wishlist, boards and outfit log every run)
QA_FREE_EMAIL=
QA_FREE_PASSWORD=
# Needs the Pro claim (sartima_tier=pro) or the admin role
QA_PRO_EMAIL=
QA_PRO_PASSWORD=

# Throwaway @example.com accounts for sign-up, onboarding, consent and
# delete-account tests. They're created and deleted within each test.
QA_ALLOW_SIGNUP_LOCAL=1
QA_ALLOW_SIGNUP_LIVE=0

# Billing tests drive Stripe Checkout with the 4242 test card. Only turn this
# on while the deployed Functions use Stripe TEST keys.
QA_STRIPE_TEST_MODE=0

# Feedback / bug-report tests are stubbed by default. 1 = send real ones
# (saved to Firestore and emailed to you on every run).
QA_REAL_FEEDBACK=0

# Local tab: "dev" (npm run dev, port 5173) or "preview" (build + preview,
# port 4173, needed for service-worker and Sentry checks). The dashboard's
# "Test against" menu sets this for you.
# QA_LOCAL_MODE=dev

# Only if they differ from the app's .env
# QA_FIREBASE_API_KEY=
# QA_FIREBASE_PROJECT_ID=
# QA_FUNCTIONS_REGION=us-central1

# Dashboard port (default 4545)
# QA_DASHBOARD_PORT=4545
