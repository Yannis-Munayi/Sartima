rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Only the authenticated owner can read or write their profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Flat prefs documents (closet, wishlist, liked, outfitBoards,
      // savedAesthetics, shopList, outfitLog, ...)
      match /prefs/{prefId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Interest graph — brand/aesthetic/type affinities written by the client, read by scoring
      match /prefs/interests {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Usage counters and subscription state — written only by admin SDK (Cloud Functions).
      // More specific paths take precedence over the /prefs/{prefId} wildcard above.
      match /prefs/usage {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      match /prefs/subscription {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Outfit calendar plans (OutfitCalendarScreen uses addDoc/deleteDoc here)
      match /outfitPlans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Quiz history (ResultsScreen writes, ProfileScreen reads)
      match /quizzes/{quizId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Uploaded catalog items (WishlistScreen)
      match /uploadedItems/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Feedback submissions — written only via submitFeedback Firebase Function (admin SDK bypasses rules).
    // Block all direct client access.
    match /feedback/{docId} {
      allow read, write: if false;
    }

    // Crash reports — written only via submitCrashReport Firebase Function.
    match /crashReports/{docId} {
      allow read, write: if false;
    }

    // Deny every other path — no public reads, no cross-user access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
