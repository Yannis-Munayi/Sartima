rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Only the authenticated owner can read or write their profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Flat prefs documents (closet, wishlist, liked, outfitBoards, savedAesthetics,
      // shopList, outfitLog, interests, ...). Owner read/write.
      //
      // usage and subscription are owner read-only: they hold usage counters,
      // try-on credits and Stripe IDs, written only by Cloud Functions (admin SDK).
      // They must be excluded HERE — Firestore rules are OR'd, so a separate
      // `allow write: if false` block can never override a wildcard that allows.
      match /prefs/{prefId} {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId
                     && !(prefId in ['usage', 'subscription']);
      }

      // Outfit calendar plans (OutfitCalendarScreen uses addDoc/deleteDoc here)
      match /outfitPlans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Quiz history (ResultsScreen writes, ProfileScreen reads)
      match /quizzes/{quizId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Uploaded catalog items (WishlistScreen)
      match /uploadedItems/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Feedback submissions — written only via submitFeedback Firebase Function (admin SDK bypasses rules).
    // Block all direct client access.
    match /feedback/{docId} {
      allow read, write: if false;
    }

    // Crash reports — written only via submitCrashReport Firebase Function.
    match /crashReports/{docId} {
      allow read, write: if false;
    }

    // Deny every other path — no public reads, no cross-user access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
